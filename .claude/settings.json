{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(python3 -m http.server:*)",
      "Bash(node update_nav.js)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(python3 scripts/update_docs.py:*)",
      "Bash(python3 -I scripts/update_docs.py:*)",
      "Bash(python3 scripts/dev_server.py:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr create:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Edit(./404.html)"
    ]
  }
}
